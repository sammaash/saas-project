# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Testing / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Local database dumps / artefacts — never commit data dumps
*.dump
*.backup
*.sql.gz
*.sql.bz2

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp