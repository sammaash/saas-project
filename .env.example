# Multi-tenant SaaS platform — environment variables (Phase 1)
#
# Copy to `.env` for local development. `.env` is gitignored; this example file is not.
#
# These are all BACKEND-ONLY values. They must never be exposed to a browser, a mobile
# client or any frontend build.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Connection string for tenant-scoped application queries.
#
# The role here must be subject to Row Level Security. Use the dedicated application role
# (`app_backend`), which owns no table and does not hold BYPASSRLS.
#
# Do NOT use Supabase's `service_role` key for tenant-scoped queries: it bypasses RLS
# entirely, which would make every isolation policy decorative. Do NOT use the table owner
# or a superuser either.
#
# SAAS_DATABASE_URL=postgresql://app_backend:password@127.0.0.1:5432/saas_platform

# Connection string used by the isolation test suite. Falls back to SAAS_DATABASE_URL when
# unset, so a single local database can serve both purposes. CI points this at its
# disposable service container.
#
# SAAS_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/saas_platform_test

# Platform provisioning login credentials are configured out of band.

\r\n
# ---------------------------------------------------------------------------
# Platform admin dashboard (backend-only; never expose to a browser)
# ---------------------------------------------------------------------------
# Login for platform functions. Holds no table privileges; configure out of band.
# SAAS_PLATFORM_DATABASE_URL=postgresql://saas_platform_admin:password@127.0.0.1:5432/saas_platform
# Random 32+ character value used to sign the session cookie.
# PLATFORM_SECRET_KEY=
# Supabase Auth (the anon/publishable key is used server-side to sign in; never the service_role key).
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=
# Only for projects that still sign tokens with the legacy HS256 secret; otherwise JWKS is used.
# SUPABASE_JWT_SECRET=
# Set to 1 ONLY for plain-http localhost development.
# PLATFORM_INSECURE_COOKIES=0
# Comma-separated phone_number_ids the dashboard must refuse to connect (e.g. live numbers).
# META_BLOCKED_PHONE_NUMBER_IDS=
# Channels can only be activated when this is 1 (leave 0 until live routing is intended).
# PLATFORM_ALLOW_ACTIVE_CHANNELS=0
# Operator-only connection for db/bootstrap_platform_admin.py; never a runtime variable.
# SAAS_OPERATOR_DATABASE_URL=
